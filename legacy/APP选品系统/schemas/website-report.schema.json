{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://app-selection.local/schemas/website-report.schema.json",
  "title": "Unified Website Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["report", "candidates"],
  "properties": {
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "periodLabel", "publishedAt", "title", "summary", "status", "sourceRunId", "methodologyVersion", "payload"],
      "properties": {
        "id": { "type": "string", "minLength": 3 },
        "periodLabel": { "type": "string", "minLength": 1 },
        "publishedAt": { "type": "string", "format": "date-time" },
        "title": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "status": { "enum": ["draft", "partial", "published"] },
        "sourceRunId": { "type": "string", "minLength": 1 },
        "methodologyVersion": { "type": "string", "minLength": 1 },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["marketPulse", "sources", "scheduledCount"],
          "properties": {
            "marketPulse": { "type": "string" },
            "sources": { "type": "array", "items": { "type": "string" } },
            "scheduledCount": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "route", "title", "titleZh", "productForm", "category", "market", "routeScore", "routeRank", "decision", "dataCompleteness", "opportunity", "improvements", "packageStatus", "references", "iconSource"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "route": { "enum": ["A", "B", "C"] },
          "title": { "type": "string", "minLength": 1 },
          "titleZh": { "type": "string", "minLength": 1 },
          "productForm": { "enum": ["mobile_app", "mobile_game", "web_app", "desktop_app", "cross_platform"] },
          "category": { "type": "string", "minLength": 1 },
          "market": { "type": "string", "minLength": 1 },
          "routeScore": { "type": "number", "minimum": 0, "maximum": 100 },
          "routeRank": { "type": "integer", "minimum": 1 },
          "decision": { "enum": ["ROUTE_SELECTED", "ROUTE_BACKUP", "ROUTE_WATCH", "REJECTED"] },
          "dataCompleteness": { "type": "number", "minimum": 0, "maximum": 1 },
          "opportunity": { "type": "string", "minLength": 1 },
          "improvements": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "items": { "type": "string", "minLength": 1 }
          },
          "packageStatus": { "enum": ["READY_FOR_BENCH", "DRAFT", "BLOCKED"] },
          "packageId": { "type": ["string", "null"], "minLength": 3 },
          "packageUrl": { "type": ["string", "null"], "pattern": "^(https?://|/)" },
          "packageSha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
          "references": {
            "type": "array",
            "minItems": 1,
            "maxItems": 5,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "nameZh", "kind", "url", "store", "storeUrl", "relation"],
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "nameZh": { "type": "string", "minLength": 1 },
                "kind": { "enum": ["mobile_app", "mobile_game", "web_product", "desktop_app", "open_source_project", "system_feature", "developer_platform", "technical_standard", "research_report"] },
                "url": { "type": "string", "format": "uri", "pattern": "^https?://" },
                "store": { "enum": ["apple_app_store", "google_play", null] },
                "storeUrl": { "type": ["string", "null"], "format": "uri", "pattern": "^https?://" },
                "relation": { "enum": ["competitor", "similar", "substitute"] },
                "apkDownloads": {
                  "type": "array",
                  "maxItems": 3,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["provider", "label", "url", "status"],
                    "properties": {
                      "provider": { "enum": ["apkmirror", "uptodown", "f_droid", "amazon_appstore", "aurora_store", "aptoide", "apkpure", "other"] },
                      "label": { "type": "string", "minLength": 1 },
                      "url": { "type": "string", "format": "uri", "pattern": "^https://" },
                      "status": { "enum": ["verified", "needs_verification"] }
                    }
                  }
                }
              }
            }
          },
          "iconUrl": { "type": ["string", "null"], "format": "uri", "pattern": "^https?://" },
          "iconSource": { "enum": ["product", "competitor", "generated"] },
          "iconSourceUrl": { "type": ["string", "null"], "format": "uri", "pattern": "^https?://" }
        }
      }
    }
  }
}
