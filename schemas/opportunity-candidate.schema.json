{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://app-selection.local/schemas/opportunity-candidate.schema.json",
  "title": "Route-scoped App Opportunity Candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "candidate_id",
    "title",
    "product_form",
    "title_zh",
    "source_engine",
    "stage",
    "target_market",
    "target_user",
    "core_job",
    "trigger",
    "current_alternative",
    "reference_gate",
    "evidence_ids",
    "route_score",
    "route_rank",
    "route_methodology_version",
    "data_completeness",
    "improvement_points",
    "next_validation",
    "stop_conditions",
    "decision",
    "confidence",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": { "const": "1.1" },
    "candidate_id": { "type": "string", "minLength": 3 },
    "parent_opportunity_id": { "type": ["string", "null"] },
    "title": { "type": "string", "minLength": 1 },
    "product_form": { "enum": ["mobile_app", "mobile_game", "web_app", "desktop_app", "cross_platform"] },
    "title_zh": { "type": "string", "minLength": 1 },
    "source_engine": {
      "enum": ["competitor_validated", "gap_redesign", "emerging_demand"]
    },
    "source_run_id": { "type": ["string", "null"] },
    "stage": {
      "enum": [
        "ROUTED_HYPOTHESIS",
        "EVIDENCE_BUILDING",
        "ROUTE_QUALIFIED",
        "ROUTE_POOL",
        "ROUTE_SELECTED",
        "ROUTE_BACKUP",
        "ROUTE_WATCH",
        "READY_FOR_BENCH",
        "REJECTED",
        "BUILDING",
        "QA",
        "RC",
        "SUBMITTED",
        "RELEASED",
        "SCALE",
        "ITERATE",
        "MAINTAIN",
        "KILL"
      ]
    },
    "target_market": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "target_user": { "type": "string", "minLength": 1 },
    "core_job": { "type": "string", "minLength": 1 },
    "trigger": { "type": "string", "minLength": 1 },
    "current_alternative": { "type": "string", "minLength": 1 },
    "lifecycle": { "enum": ["existing", "flash", "emerging", "structural"] },
    "signal_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string" }
    },
    "evidence_ids": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": { "type": "string" }
    },
    "reference_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "required_count", "actual_count", "passed"],
      "properties": {
        "type": {
          "enum": ["direct_competitor", "substitute_or_workaround", "leading_signal_plus_behavior"]
        },
        "required_count": { "type": "integer", "minimum": 1 },
        "actual_count": { "type": "integer", "minimum": 0 },
        "passed": { "type": "boolean" }
      }
    },
    "route_score": { "type": "number", "minimum": 0, "maximum": 100 },
    "route_rank": { "type": "integer", "minimum": 1 },
    "route_methodology_version": { "type": "string", "minLength": 1 },
    "data_completeness": { "type": "number", "minimum": 0, "maximum": 1 },
    "improvement_points": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": { "type": "string", "minLength": 1 }
    },
    "ai_role": { "enum": ["none", "background", "foreground"] },
    "minimum_build": { "type": ["string", "null"] },
    "monetization": { "type": ["string", "null"] },
    "acquisition": { "type": ["string", "null"] },
    "next_validation": { "type": "string", "minLength": 1 },
    "stop_conditions": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "decision": {
      "enum": ["SELECTED", "BACKUP", "WATCH", "REJECTED"]
    },
    "confidence": { "enum": ["low", "medium", "high"] },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "methodology_version": { "type": "string" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "source_engine": { "const": "competitor_validated" } },
        "required": ["source_engine"]
      },
      "then": {
        "properties": {
          "reference_gate": {
            "properties": {
              "type": { "const": "direct_competitor" },
              "required_count": { "const": 3 }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "source_engine": { "const": "gap_redesign" } },
        "required": ["source_engine"]
      },
      "then": {
        "properties": {
          "reference_gate": {
            "properties": {
              "type": { "const": "substitute_or_workaround" },
              "required_count": { "const": 3 }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "source_engine": { "const": "emerging_demand" } },
        "required": ["source_engine"]
      },
      "then": {
        "properties": {
          "reference_gate": {
            "properties": {
              "type": { "const": "leading_signal_plus_behavior" },
              "required_count": { "const": 3 }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "decision": { "const": "SELECTED" } },
        "required": ["decision"]
      },
      "then": {
        "properties": {
          "route_score": { "minimum": 75 },
          "data_completeness": { "minimum": 0.8 },
          "reference_gate": {
            "properties": {
              "passed": { "const": true }
            }
          }
        }
      }
    }
  ]
}
